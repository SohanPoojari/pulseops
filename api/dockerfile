# ==========================================
# STAGE 1: Builder
# ==========================================
FROM python:3.11-slim AS builder

WORKDIR /app

# Pin dependencies - copying only what's needed for the install step
COPY requirements.txt .

# This Install dependencies into the user's home directory 
RUN pip install --user --no-cache-dir -r requirements.txt

# ==========================================
# STAGE 2: Runtime
# ==========================================
FROM python:3.11-slim AS runtime

# This will Create a dedicated non-root user (CRITICAL REQUIREMENT)
RUN useradd -m -s /bin/bash appuser

WORKDIR /app

# this Copy ONLY the installed dependencies from the builder stage
COPY --from=builder /root/.local /home/appuser/.local

# it will Copy the actual application code
COPY . .

#it will Update PATH so the system knows where the installed pip packages are
ENV PATH=/home/appuser/.local/bin:$PATH

# this will Lock down file ownership to the non-root user
RUN chown -R appuser:appuser /app

# below will Switch to the non-root user
USER appuser

# 7. Expose the API port
EXPOSE 8000

# 8. Start the FastAPI application gracefully
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]